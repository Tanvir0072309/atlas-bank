# Copy this file to ".env" in the same folder (server/.env) and fill in real values.

PORT=5000

# MongoDB connection string
MONGODB_URI=mongodb://127.0.0.1:27017/atlasbank

# JWT secrets — use long random strings in production
JWT_ACCESS_SECRET=change_this_access_secret
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_SECRET=change_this_refresh_secret
JWT_REFRESH_EXPIRES_IN=7d
JWT_PASSWORD_RESET_SECRET=change_this_reset_secret
JWT_PASSWORD_RESET_EXPIRES_IN=15m

# AES-256 key used to encrypt bank account numbers at rest.
# Must be exactly 64 hex characters (32 bytes). Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENCRYPTION_KEY=

# Email (nodemailer) — used for OTPs / verification emails
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM="Atlas Bank <no-reply@atlasbank.com>"

# ==========================================
# AI Financial Assistant (Groq)
# ==========================================
# 1. Create a free key at https://console.groq.com/keys
# 2. Paste it below (this file is just an example - put the real key in server/.env, never commit it)
GROQ_API_KEY=
# Optional - defaults to openai/gpt-oss-120b if not set (llama-3.3-70b-versatile is deprecated)
GROQ_MODEL=openai/gpt-oss-120b
